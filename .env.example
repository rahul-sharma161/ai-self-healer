ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Optional: GitHub PR creation (PDF steps 6-7).
# Leave GITHUB_TOKEN empty to skip commit + PR entirely (heals stay local only).
# Set both to enable: on a verified fix the assistant branches, commits, pushes, and opens a PR.
GITHUB_TOKEN=
GITHUB_REPO=
GIT_BASE_BRANCH=main
